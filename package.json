{
  "name": "education",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev": "npm run build:libs && concurrently -k -n api,web \"npm run dev -w @education/api\" \"npm run dev -w @education/web\"",
    "build": "npm run build:libs && npm run build -w @education/api && npm run build -w @education/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . && npm run lint -w @education/web",
    "arch": "npm run arch --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "npm run storybook -w @education/web",
    "build-storybook": "npm run build-storybook -w @education/web",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w @education/api",
    "db:migrate": "npm run db:migrate -w @education/api",
    "check": "npm run build:libs && npm run format:check && npm run lint && npm run arch && npm run typecheck && npm test && npm run build && npm run build-storybook",
    "build:libs": "npm run build -w @education/contracts && npm run build -w @education/problems",
    "test:db": "npm run test:db -w @education/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.6",
    "dependency-cruiser": "^18.7.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jscpd": "^5.4.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
