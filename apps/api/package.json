{
  "name": "@education/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "arch": "node ../../scripts/arch-check.mjs",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:complete-deletions": "tsx src/complete-deletions.ts",
    "test:db": "vitest run --config vitest.database.config.ts"
  },
  "dependencies": {
    "@education/contracts": "*",
    "@education/problems": "*",
    "@fastify/static": "^10.1.10",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@sinclair/typebox": "^0.34.52",
    "argon2": "0.45.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "nodemailer": "^10.4.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "smtp-server": "^3.21.3"
  }
}
