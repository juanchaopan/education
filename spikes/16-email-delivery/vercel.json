{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "regions": ["sin1"],
  "functions": { "api/probe.js": { "maxDuration": 30 } },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
