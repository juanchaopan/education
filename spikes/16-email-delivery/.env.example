# Use a dedicated personal Gmail sender; never use the normal Google password.
GMAIL_USER=replace-with-sender@gmail.com
GMAIL_APP_PASSWORD=replace-with-app-password-without-spaces
# Only a recipient who explicitly agreed to receive this test.
MAIL_PROBE_TO=replace-with-recipient@126.com
MAIL_PROBE_CONFIRM_TO=replace-with-recipient@126.com
MAIL_PROBE_PURPOSE=verify
# For the private Vercel test page, configure this variable in Preview.
MAIL_PROBE_126=replace-with-recipient@126.com
