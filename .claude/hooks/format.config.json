{
  "rules": [
    {
      "dir": "apps/web",
      "extensions": [".ts", ".tsx", ".css"],
      "format": "npx --no-install prettier --write {file}",
      "lint": "npx --no-install oxlint --deny-warnings -c ../../.oxlintrc.json {file}"
    },
    {
      "dir": "apps/api",
      "extensions": [".ts"],
      "format": "npx --no-install prettier --write {file}",
      "lint": "npx --no-install oxlint --deny-warnings -c ../../.oxlintrc.json {file}"
    }
  ]
}
