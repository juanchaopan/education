{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:staging",
  "outputDirectory": "apps/web/dist",
  "regions": ["sin1"],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{apps/api/drizzle/**,apps/api/dist/release.json,apps/web/dist/index.html}",
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/(?:index\\.html)?", "headers": { "Cache-Control": "no-cache" }, "continue": true },
    { "src": "/(?:api|health)(?:/.*)?", "dest": "/api/index" },
    { "src": "/version.json", "dest": "/api/index" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/api/index" }
  ]
}
